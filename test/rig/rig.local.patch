+/**
+ * `records`: { 'llm-pi-ai/anthropic': { kind: 'grant', payload: {...} }, ... }. Written as
+ * dsh-credentials-local's version-1 document; JSON is valid YAML for every value.
+ */
+function writeCredentials(file, records) {
+  mkdirSync(join(file, '..'), { recursive: true });
+  const entries = Object.entries(records);
+  const lines = ['version: 1', entries.length === 0 ? 'records: {}' : 'records:'];
+  for (const [key, record] of entries) lines.push(`  ${key}: ${JSON.stringify(record)}`);
+  writeFileSync(`${file}.tmp`, `${lines.join('\n')}\n`, { mode: 0o600 });
+  renameSync(`${file}.tmp`, file);
+}
